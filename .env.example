# ==========================================
# QUANTUM SCHOOL & COLLEGE - BACKEND MVP ENV
# ==========================================

# SERVER CONFIGURATION
PORT=3001
NODE_ENV=development

# DATABASE CONFIGURATION
# Local SQLite for free-first development
DATABASE_URL="file:./dev.db"
# Example PostgreSQL for production: 
# DATABASE_URL="postgresql://user:password@localhost:5432/quantum_school?schema=public"

# AUTHENTICATION
JWT_SECRET="generate-a-secure-random-secret-key-here"
JWT_EXPIRES_IN="7d"

# ==========================================
# OPTIONAL: EXTERNAL PAID SERVICES
# ==========================================
# Note: Add the credentials below to enable 
# external features. The backend architecture
# is already built to support them.

# 1. SMS PROVIDER (For Attendance/Result Notifications)
ENABLE_SMS=false
SMS_PROVIDER="twilio" # twilio, nexmo, etc.
SMS_API_KEY=""
SMS_API_SECRET=""
SMS_SENDER_ID=""

# 2. EMAIL NOTIFICATIONS (For Password Reset/Notices)
ENABLE_EMAIL=false
EMAIL_PROVIDER="sendgrid" # sendgrid, aws-ses, smtp
EMAIL_API_KEY=""
EMAIL_FROM_ADDRESS=""

# 3. CLOUD STORAGE (For Profile/Gallery Images instead of local)
ENABLE_CLOUD_STORAGE=false
CLOUD_STORAGE_PROVIDER="s3" # s3, cloudinary
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""
AWS_REGION=""

# 4. PAYMENT GATEWAY (For Online Admission/Fee Payment)
ENABLE_PAYMENT=false
PAYMENT_PROVIDER="stripe" # stripe, sslcommerz, razorpay
PAYMENT_API_KEY=""
PAYMENT_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# 5. BIOMETRIC ATTENDANCE HARDWARE
ENABLE_BIOMETRIC=false
BIOMETRIC_API_ENDPOINT=""
BIOMETRIC_API_TOKEN=""
